# Pinned upstreams are fetched, not vendored (supply-chain: pin-not-vendor).
third_party/

# Build / runtime
dist/
build/
*.pyc
__pycache__/
.venv/
node_modules/

# OS cruft
.DS_Store

# Promotion-gate runtime evidence (emitted at rollout, not committed; dir kept via .gitkeep)
artifacts/gate-decisions/*.json

# Live mesh telemetry heartbeats (emitted by nodes at runtime, not committed; dir kept via .gitkeep)
artifacts/mesh-heartbeats/*.json

# MCP ops-surface receipts (sealed per tool call at runtime; dir kept via .gitkeep)
artifacts/mcp-receipts/*.json

# Admission consumption ledger (per-subject usage, runtime state)
artifacts/admission-usage.json

# Porter control-plane build outputs (compiled locally, not committed)
artifacts/porter-shim/shim
artifacts/cloudshell-hardened-pack/culler/culler
artifacts/cloudshell-hardened-pack/spawner/spawner
*.test
